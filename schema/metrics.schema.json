{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Metrics",
  "type": "object",
  "required": [
    "coverage",
    "drones",
    "makespan",
    "total_time",
    "total_length",
    "per_drone",
    "efficiency",
    "checks"
  ],
  "properties": {
    "coverage": {
      "type": "object",
      "required": [
        "percentage",
        "reachable_cells",
        "unreachable_cells",
        "out_of_range_cells",
        "expected_cells",
        "uncovered_cells"
      ],
      "properties": {
        "percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "uncovered_cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            }
          }
        },
        "reachable_cells": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable_cells": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_range_cells": {
          "type": "integer",
          "minimum": 0
        },
        "expected_cells": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "drones": {
      "type": "object",
      "required": [
        "used",
        "max"
      ],
      "properties": {
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "makespan": {
      "type": "number",
      "minimum": 0
    },
    "total_time": {
      "type": "number",
      "minimum": 0
    },
    "per_drone": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "drone_id",
          "path_length",
          "turns",
          "recharges",
          "time"
        ],
        "properties": {
          "drone_id": {
            "type": "integer"
          },
          "path_length": {
            "type": "number",
            "minimum": 0
          },
          "turns": {
            "type": "integer",
            "minimum": 0
          },
          "recharges": {
            "type": "integer",
            "minimum": 0
          },
          "time": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "total_length": {
      "type": "number",
      "minimum": 0
    },
    "checks": {
      "type": "object",
      "required": [
        "collision_free",
        "continuous",
        "battery_ok",
        "problems"
      ],
      "properties": {
        "collision_free": {
          "type": "boolean"
        },
        "continuous": {
          "type": "boolean"
        },
        "battery_ok": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "efficiency": {
      "type": "object",
      "required": [
        "sorties",
        "steps",
        "commute_steps",
        "in_region_steps",
        "covered_cells",
        "revisit_steps",
        "commute_share",
        "steps_per_cell",
        "per_drone"
      ],
      "properties": {
        "sorties": {
          "type": "integer",
          "minimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "commute_steps": {
          "type": "integer",
          "minimum": 0
        },
        "in_region_steps": {
          "type": "integer",
          "minimum": 0
        },
        "covered_cells": {
          "type": "integer",
          "minimum": 0
        },
        "revisit_steps": {
          "type": "integer",
          "minimum": 0
        },
        "commute_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "steps_per_cell": {
          "type": "number",
          "minimum": 0
        },
        "per_drone": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "drone_id",
              "sorties",
              "steps",
              "commute_steps",
              "in_region_steps",
              "covered_cells",
              "revisit_steps"
            ],
            "properties": {
              "sorties": {
                "type": "integer",
                "minimum": 0
              },
              "steps": {
                "type": "integer",
                "minimum": 0
              },
              "commute_steps": {
                "type": "integer",
                "minimum": 0
              },
              "in_region_steps": {
                "type": "integer",
                "minimum": 0
              },
              "covered_cells": {
                "type": "integer",
                "minimum": 0
              },
              "revisit_steps": {
                "type": "integer",
                "minimum": 0
              },
              "drone_id": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
